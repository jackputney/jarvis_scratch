# Copy this file to .env and fill in your keys.
# Never commit .env to version control.

# Required: Anthropic API key for Claude (haiku + sonnet)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: alternate LLM backends. Default provider is Anthropic.
# To switch, set "llm_provider" to "openai" or "gemini" in config.json AND set
# "claude_model_fast"/"claude_model_smart" to that provider's model names
# (those two fields are the fast/smart models for whichever provider is active).
# Requires the matching SDK: pip install openai  /  pip install google-genai
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Cartesia API key for streaming TTS.
# If unset, Jarvis falls back to pyttsx3 local TTS.
CARTESIA_API_KEY=your_cartesia_api_key_here

# Optional: ElevenLabs API key for primary streaming TTS.
# If unset, Jarvis falls back to Cartesia (then pyttsx3).
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Google OAuth (Calendar, Gmail, Sheets tools)
# Create a Desktop OAuth client at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Optional: read/write access to Jarvis's own GitHub repo (reflect.py + self-read/write tools)
# Scopes: Contents (read/write), Issues, Pull requests
GITHUB_PAT=ghp_your_token_here
