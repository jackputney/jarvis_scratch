# Copy this file to .env and fill in your keys.
# Never commit .env to version control.

# Required: Anthropic API key for Claude (haiku + sonnet)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Cartesia API key for streaming TTS.
# If unset, Jarvis falls back to pyttsx3 local TTS.
CARTESIA_API_KEY=your_cartesia_api_key_here

# Google OAuth (Calendar, Gmail, Sheets tools)
# Create a Desktop OAuth client at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
