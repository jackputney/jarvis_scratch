# Environment and secrets
.env
config.json
credentials.json
*.bak

# Memory data (personal, never committed)
memory/knowledge/
memory/diary/
memory/profile.md
memory/semantic_index.db
memory/variables.db
memory/google_token.json
# SQLite WAL/SHM sidecars are machine-specific — never commit (they corrupt
# another machine's DB on checkout). Broad patterns cover every *.db.
*.db-shm
*.db-wal

